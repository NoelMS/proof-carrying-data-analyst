# Copy to .env (or export) and adjust. No value here is a real credential.

# Question interpretation and proof writing: "anthropic", "none" (deterministic), or "auto"
# (auto = anthropic when ANTHROPIC_API_KEY is set).
PCDA_LLM_PROVIDER=auto
PCDA_LLM_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=your-key-here

# Execution sandbox: "subprocess" (default) or "docker" (build Dockerfile.sandbox first)
PCDA_SANDBOX=subprocess
PCDA_DOCKER_IMAGE=pcda-sandbox:latest
PCDA_TIMEOUT_S=30
PCDA_MEMORY_MB=1024
PCDA_MAX_REPAIRS=2
PCDA_DEBUG=0

# Google Gemini instead of Claude (free tier available at https://aistudio.google.com/apikey).
# GEMINI_API_KEY=your-key-here
# PCDA_LLM_PROVIDER=gemini
# PCDA_GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.5-flash  # tried in order
# PCDA_LLM_TIMEOUT_S=3  # slower AI answers fall back to the built-in reader / templates
