# Copy to .env (or export) and adjust. No value here is a real credential.

# Who reads questions and writes the proofs:
#   "local"     - local agent: a small model served by Ollama on this PC (install it from the System page)
#   "none"      - rules only: deterministic parser and code templates, no model
#   "auto"      - local when the model is installed, else none.
#                 A mode chosen in the app overrides auto.
PCDA_LLM_PROVIDER=auto
PCDA_LOCAL_MODEL=qwen2.5-coder:1.5b
# Fine-tuned question reader (training/); used for reading questions once installed with scripts/install_local_model.py
PCDA_INTERPRETER_MODEL=pcda-interpreter
PCDA_OLLAMA_URL=http://127.0.0.1:11434

# Execution sandbox: "subprocess" (default) or "docker" (build Dockerfile.sandbox first)
PCDA_SANDBOX=subprocess
PCDA_DOCKER_IMAGE=pcda-sandbox:latest
PCDA_TIMEOUT_S=30
PCDA_MEMORY_MB=1024
PCDA_MAX_REPAIRS=2
PCDA_DEBUG=0
