# Copy to .env (or export) and adjust. No value here is a real credential.

# Question interpretation and proof writing: "anthropic", "none" (deterministic), or "auto"
# (auto = anthropic when ANTHROPIC_API_KEY is set).
PCDA_LLM_PROVIDER=auto
PCDA_LLM_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=your-key-here

# Execution sandbox: "subprocess" (default) or "docker" (build Dockerfile.sandbox first)
PCDA_SANDBOX=subprocess
PCDA_DOCKER_IMAGE=pcda-sandbox:latest
PCDA_TIMEOUT_S=30
PCDA_MEMORY_MB=1024
PCDA_MAX_REPAIRS=2
PCDA_DEBUG=0
